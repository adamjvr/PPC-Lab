{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppc-lab.invalid/schemas/ppc-lab-exploration-v1.schema.json",
  "title": "PPC Lab guided exploration manifest v1",
  "type": "object",
  "required": [
    "schema",
    "base_job",
    "axes"
  ],
  "properties": {
    "schema": {
      "const": "ppc-lab-exploration-v1"
    },
    "strategy": {
      "enum": [
        "guided",
        "adaptive",
        "cartesian"
      ]
    },
    "max_cases": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "base_job": {
      "type": "object"
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "values"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 3
          },
          "values": {
            "type": "array",
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "adaptive": {
      "type": "object",
      "properties": {
        "plateau_window": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "plateau_novelty_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_cases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
