    },
    "cpp_api": {
      "minimum": 1,
      "type": "integer"
    },
    "installed_tools": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "persisted_formats": {
      "type": "object"
    },
    "platform_major": {
      "minimum": 1,
      "type": "integer"
